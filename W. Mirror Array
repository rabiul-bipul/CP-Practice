#include <iostream>
using namespace std;

int main()
{
    int N, M;
    scanf("%d", &N);
    scanf("%d", &M);
    int ara[N][M];
    for (int row = 0; row < N; row++)
    {
        for (int col = 0; col < M; col++)
        {
            scanf("%d", &ara[row][col]);
        }
    }

    for (int row = 0; row < N; row++)
    {
        for (int col = M - 1; col >= 0; col--)
        {
            printf("%d ", ara[row][col]);
        }
        printf("\n");
    }

    return 0;
}
