#include <iostream>
using namespace std;

int main()
{
    int ara[101][101];
    int n;
    scanf("%d", &n);

    for (int row = 1; row <= n; row++)
    {
        for (int col = 1; col <= n; col++)
        {
            scanf("%d", &ara[row][col]);
        }
    }

    int psum = 0;
    int prow = 1, pcol = 1;
    for (int d = 0; d <= n-1; d++)
    {
        psum += ara[prow][pcol];
        prow++;
        pcol++;
    }

    int ssum = 0;
    int srow = n, scol = 1;
    for (int d = 0; d <= n - 1; d++)
    {
        ssum += ara[srow][scol];
        srow--;
        scol++;
    }

    int ans = (psum - ssum);
    if (ans < 0)
        ans *= -1;
    printf("%d",ans);
    return 0;
}
